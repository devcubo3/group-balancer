# ==============================================
# SUPABASE CONFIGURATION
# ==============================================
# Chave ANON. Precisa continuar sendo a anon: o painel a injeta no HTML que
# serve ao navegador (src/painel_web.py).
SUPABASE_URL=https://gvtycxhzbzkrtbbwjcmy.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imd2dHljeGh6YnprcnRiYndqY215Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3Njc2MjQ1NjAsImV4cCI6MjA4MzIwMDU2MH0.OP0O5SjtvI8b0x2HI-OTrdHF1j8-FwR4MGhrstm_MkE

# Chave SERVICE ROLE (Supabase > Settings > API). Usada só pelo rastreio de
# membros por anúncio: grupo_membros e grupo_eventos guardam telefone de gente
# real e ficam com RLS sem policy de leitura, justamente para a chave acima --
# que está publicada no JS da landing page -- não alcançá-las.
# Vazia: o rastreio fica desligado e o resto do monitor roda igual.
SUPABASE_SERVICE_KEY=

# ==============================================
# WHATSAPP API CONFIGURATION (UAZAPI)
# ==============================================
# Host da UazAPI. NÃO deixe em branco: o default do config.py é
# https://free.uazapi.com, e um token de outro host retorna 401.
WHATSAPP_API_URL=https://free.uazapi.com

# ATENÇÃO: token da INSTÂNCIA, não o token da CONTA UazAPI.
# O balancer só faz operações de instância (/group/create, /group/info, ...) e
# manda este valor no header `token`. O token da conta é recusado nesses
# endpoints com HTTP 401 "Invalid token" — e a falha some no log se você não
# olhar api_call_logs.
WHATSAPP_API_TOKEN=d2ff2337-c38c-46fa-9e1b-6d3689e23f99

# Número da instância. Entra como participante dos grupos criados e é gravado
# em controle_grupos.instance_name.
WHATSAPP_ADMIN_NUMBER=553391269004

# Configurações de Grupo
GROUP_DESCRIPTION=Bem-vindo ao grupo! Este é um espaço exclusivo para promoções e ofertas incríveis.
GROUP_IMAGE_URL=https://exemplo.com/imagem-do-grupo.jpg

# ==============================================
# BUSINESS RULES
# ==============================================
# Limite para começar a redirecionar para outro grupo
MAX_MEMBERS_FOR_REDIRECT=900

# Gatilho para criar novo grupo automaticamente
SCALE_OUT_THRESHOLD=900

# Limite real do WhatsApp (não modificar)
WHATSAPP_MAX_CAPACITY=1000

# Um nicho não ganha dois grupos dentro desta janela (minutos). Um grupo leva
# semanas para encher, então criações em sequência são bug, não demanda —
# em 2026-09-12 uma falha de leitura criou 8 grupos em 9h. Ver ARCHITECTURE.md.
GROUP_CREATE_COOLDOWN_MINUTES=60

# --- Painel de grupos ---------------------------------------------------
# O painel sobe junto com `python main.py monitor`, no mesmo processo.
# No Dokploy, aponte o domínio para esta porta.
PAINEL_PORT=8080
# Vazio = painel aberto a quem souber a URL (ele expõe links de convite e a
# SUPABASE_KEY para o navegador). Preenchido, exige ?t=<token> na URL.
PAINEL_TOKEN=

# ==============================================
# MONITOR CONFIGURATION
# ==============================================
# Intervalo de verificação do grupo mais novo (em segundos)
MONITOR_CHECK_INTERVAL=60

# Intervalo para sincronização diária (em horas)
DAILY_SYNC_INTERVAL=24

# Delay entre chamadas API para evitar rate limit (em segundos)
API_CALL_DELAY=2

# Timeout para chamadas API (em segundos)
API_TIMEOUT=30

# --- Rastreio de membros e atribuição de anúncio ------------------------
# (só valem com SUPABASE_SERVICE_KEY preenchida)
# Roster de TODOS os grupos ativos, em minutos. O grupo mais novo de cada nicho
# já é conferido a cada MONITOR_CHECK_INTERVAL; isto aqui é pelos antigos, onde
# ninguém entra mas ainda se sai. Custa 1 chamada /group/info por grupo ativo.
ROSTER_INTERVAL_MIN=5
# Por quanto tempo um clique na landing continua elegível para casar com uma
# entrada no grupo, em minutos.
ATRIBUICAO_JANELA_MIN=30

# Intervalo do monitor diário em MODO DE TESTE (em minutos)
# Usado apenas pelo test_daily_monitor.py para testes em tempo real
# Para produção, use daily_monitor.py agendado 1x por dia
DAILY_MONITOR_TEST_INTERVAL=3

# ==============================================
# LOGGING
# ==============================================
LOG_LEVEL=INFO
LOG_FILE=logs/monitor.log
